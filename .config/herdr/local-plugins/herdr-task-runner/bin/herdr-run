#!/usr/bin/env bash
# Usage: herdr-run [options] <command...>
# (the herdr-task-runner plugin's bin/ is on PATH in your shell after sourcing ../shell.sh; key bindings and other
# places that don't use your shell's PATH call it by its full path)
#
# Where it runs:
#   (default)  in the focused pane if its shell is idle, else in a new tab
#   --tab      always in a new tab
#   --split    always in a new split pane next to the focused one
#   --workspace  where the command has to run in --cwd (or the focused pane's directory), matched exactly: in the
#              focused pane if it is there and idle; else in a workspace that has a pane exactly there (an idle
#              pane runs the command, a busy one gets a new tab); else in a new workspace. A pane in another
#              directory, even one below or above it, is never cd'ed or reused
#   --work-dir DIR  like --workspace for DIR. When the focused pane is in DIR already it is exactly the
#              default (idle pane: typed into it, busy pane: new tab). Without a command it only goes there
#   --here     run in this very terminal (no new tab or pane), e.g. in a popup; --ask/--ask-if still apply
#   --job      shortcut for a long-running command: --tab --linger 1m (HERDR_RUN_LINGER changes the 1m).
#              A --keep or --linger after it replaces the linger, e.g. `--job --keep`, `--job --linger 10m`
#   --background  start it without taking you there: no focus change and a "Started in background"
#              notification. In your own workspace a new tab (never your pane). --work-dir: an idle pane of
#              another workspace open in DIR is used (so its sidebar shows the app), else a new tab in it,
#              else a new workspace. With --linger a failure keeps its tab open marked failed (see
#              herdr-run-hold); not with --here/--split
#              Without a command it only goes there (nothing is typed), e.g. `herdr-run --work-dir DIR`
#   --cwd DIR  run in DIR instead of the focused pane's directory (an idle pane is only
#              reused when it is already in DIR, otherwise a new tab is opened)
#
#   --reuse    for an app that should only be open once per workspace (e.g. lazygit): when a pane of the
#              focused workspace already runs exactly <command> (compared without quotes) as its foreground
#              process, jump to its tab instead of starting another. Only for the default and --tab modes; without it every call opens one
#
# What happens around it (new tabs/splits/workspaces; --ask and the done/failed mark of --keep/--linger also
# apply to an idle pane, which always stays open: there only the mark is kept, there is no countdown):
#   --keep     leave the shell open when <command> exits (default: the pane closes),
#              e.g. to read the output of a failed build
#              For commands that ran at least 10s (herdr-ohmyzsh's threshold), --keep/--linger also keep
#              the command's sidebar entry as "done" until you focus the pane (see herdr-run-hold);
#              with --linger that wait ends when the linger is over.
#   --linger D keep the pane open for D (e.g. 90, 90s, 1m) after <command> exits, then close it, even if
#              you never looked at it, so output stays readable but the tab doesn't pile up. A command that
#              fails (non-zero exit, except Ctrl-C) is not closed: no countdown, the tab stays open and its
#              sidebar mark waits until you focus it. While it counts down:
#              Ctrl-C closes now, `k` (HERDR_TASK_RUNNER_KEEP_KEY) cancels the linger and keeps the tab open
#   --ask      prompt for extra arguments (in this terminal) and append them to <command>;
#              an empty answer runs it as is, Ctrl-D / Ctrl-C cancels. Needs a terminal.
#   --ask-if R like --ask, but only when <command> matches the (bash ERE) regex R,
#              e.g. --ask-if "run 'test'$" prompts only for `npm run 'test'`
#
# Other:
#   --dry-run  print what would be done (mode, directory, the exact herdr calls) and exit
#   -h, --help this text
#   --         end of options (for a command that starts with a dash)
#
# Pass a command with quoting as one argument: herdr-run --tab "npm run 'build:dev'"
# Outside herdr (no herdr env in an interactive terminal, or no reachable herdr server)
# the command just runs as is, so the same bindings/actions work anywhere.
# Failures (a missing tab id, a herdr error, bad options) are appended to
# ${XDG_STATE_HOME:-~/.local/state}/herdr/herdr-run.log and shown as a herdr notification,
# because key bindings run this detached and would otherwise fail silently. Only herdr-run's own errors
# notify: a failing command only changes its sidebar status (see herdr-run-hold).
#
# A centered popup is not a mode of this script: herdr only opens popups from a native
# key binding, so use `type = "popup"` in config.toml instead, e.g.
#   [[keys.command]]
#   key = "prefix+t"
#   type = "popup"
#   command = "tv"
#   width = "80%"
#   height = "80%"
#
# No dependencies beyond bash, grep, cut, head and date: herdr's replies are compact one-line
# JSON with sorted keys, so the few fields needed are pulled out with grep (see jstr/jnum).
set -Eeuo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"
log="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/herdr-run.log"

# fail MESSAGE [EXIT_CODE]: key bindings are detached, so leave a trace and a toast
fail() {
  local msg="$1" code="${2:-1}"
  { mkdir -p "$(dirname "$log")" && printf '%s %s\n' "$(date '+%F %T')" "$msg" >>"$log"; } 2>/dev/null || true
  echo "herdr-run: $msg" >&2
  "$herdr" notification show "herdr-run failed: ${msg:0:80}" --sound request >/dev/null 2>&1 || true
  exit "$code"
}
trap 'fail "line $LINENO: $BASH_COMMAND"' ERR

# jstr KEY JSON / jnum KEY JSON: first value of "KEY" in a JSON string (empty if absent)
jstr() { grep -o "\"$1\":\"[^\"]*\"" <<<"$2" | head -n1 | cut -d'"' -f4 || true; }
jnum() { grep -o "\"$1\":[0-9]*" <<<"$2" | head -n1 | cut -d: -f2 || true; }

# label_of COMMAND: the sidebar label herdr-ohmyzsh gives a command (its first real word, sanitized)
label_of() {
  local words w
  read -ra words <<<"$1"
  for w in "${words[@]}"; do
    case $w in
      *=*|-*|sudo|doas|command|builtin|exec|nohup|time|nice|env|caffeinate) continue ;;
    esac
    w="${w##*/}"; w="${w,,}"; w="${w//[^a-z0-9_-]/-}"
    [[ $w == [a-z]* ]] || w=shell
    echo "${w:0:32}"; return 0
  done
  echo shell
}

mode=
keep= linger= job= reuse= bg= ask= ask_if= dry= opt_cwd=
mode_flag=
# set_mode MODE FLAG: --tab/--job, --split, --workspace and --here pick where to run, so only one mode may be given
set_mode() {
  [[ -z $mode || $mode == "$1" ]] || fail "$mode_flag and $2 conflict (pick one of --tab/--job, --split, --workspace, --work-dir, --here)" 2
  mode=$1; mode_flag=$2
}
while (($#)); do
  case $1 in
    -h|--help) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    --tab) set_mode tab --tab ;;
    --job) set_mode tab --job; job=1 ;;
    --split) set_mode split --split ;;
    --workspace) set_mode workspace --workspace ;;
    --work-dir) set_mode workdir --work-dir; opt_cwd="${2:?--work-dir needs a directory}"; shift ;;
    --here) set_mode here --here ;;
    --reuse) reuse=1 ;;
    --background|--bg) bg=1 ;;
    --keep) keep=1 ;;
    --ask) ask=1 ;;
    --dry-run) dry=1 ;;
    --ask-if) ask_if="${2:?--ask-if needs a regex}"; shift ;;
    --cwd) opt_cwd="${2:?--cwd needs a directory}"; shift ;;
    --linger)
      linger="${2:?--linger needs a duration}"; shift
      [[ $linger =~ ^[0-9]+[smhd]?$ ]] || fail "bad --linger duration: $linger" 2 ;;
    --) shift; break ;;
    -*) fail "unknown option: $1 (see --help)" 2 ;;
    *) break ;;
  esac
  shift
done
mode="${mode:-auto}"
[[ -z $job || -n $keep || -n $linger ]] || linger="${HERDR_RUN_LINGER:-1m}" # --job
cmd="$*"
[[ -z $bg || ( $mode != here && $mode != split ) ]] || fail "--background and $mode_flag conflict" 2
[[ -n $cmd || $mode == workdir ]] || fail "no command given (see --help)" 2
# --work-dir without a command only goes to the directory: nothing is typed, so there is nothing to keep or ask
[[ -n $cmd ]] || { keep= linger= ask= ask_if=; }
[[ -z $keep || -z $linger ]] || fail "--keep and --linger conflict" 2
if [[ -n $opt_cwd ]]; then
  [[ -d $opt_cwd ]] || fail "--cwd: no such directory: $opt_cwd" 2
  opt_cwd="$(cd "$opt_cwd" && pwd)"
fi

[[ -n $ask_if && $cmd =~ $ask_if ]] && ask=1
if [[ -n $ask ]]; then
  if [[ -n $dry ]]; then
    echo "would ask for extra arguments: $cmd ›"
  # tv's `execute` mode may not give us a tty on stdin, so talk to the controlling terminal directly
  elif { : </dev/tty; } 2>/dev/null; then
    read -e -r -p "$cmd › " extra </dev/tty >/dev/tty || exit 0 # Ctrl-D cancels
    [[ -n $extra ]] && cmd+=" $extra"
  else
    echo "herdr-run: --ask needs a terminal, running without extra arguments" >&2
  fi
fi

if [[ $mode == here ]]; then
  if [[ -n $dry ]]; then echo "here: would run: bash -c $(printf '%q' "$cmd")${opt_cwd:+ (in $opt_cwd)}"; exit 0; fi
  [[ -z $opt_cwd ]] || cd "$opt_cwd"
  exec bash -c "$cmd"
fi

# name_pane PANE: show the whole command (not just the label, "npm") as the pane's sidebar name while it
# runs, if herdr-ohmyzsh registers it. The same text goes in a `cmd` pane token, which stays readable
# when no sidebar entry exists, so herdr-run-hold can recover the command. It clears both again.
name_pane() {
  local name="$cmd"
  if ((${#name} > 80)); then name="${name:0:79}…"; fi
  hc pane report-metadata "$1" --source task-runner --agent "$(label_of "$cmd")" --applies-to-source ohmyzsh \
    --display-agent "$name" --token "cmd=$name" --token "start=$(date +%s)" --seq "$(date +%s%6N)" >/dev/null || true
}

# hc ARGS...: a herdr call that changes something (printed instead of run with --dry-run).
# Reports its own failure (with herdr's message), so call sites in $(...) add `|| exit 1`
# to stop without reporting it a second time.
hc() {
  if [[ -n $dry ]]; then
    { printf 'would run: herdr'; printf ' %q' "$@"; printf '\n'; } >&2
    return 0
  fi
  local out rc=0
  out="$("$herdr" "$@" 2>&1)" || rc=$?
  ((rc == 0)) || fail "herdr $1 $2 failed ($rc): ${out:0:100}"
  printf '%s\n' "$out"
}
# a herdr call that fails with exit 0 still prints {"error":...}
check() {
  [[ $1 != *'"error":'* ]] || fail "herdr: $(jstr message "$1")"
}

# Not in herdr: run the command as is. A herdr key binding runs detached without a tty, so
# "no tty" counts as "in herdr"; an interactive terminal without herdr env does not.
if ! command -v "$herdr" >/dev/null 2>&1 ||
   { [[ -t 0 && -z ${HERDR_PANE_ID:-}${HERDR_SOCKET_PATH:-} ]]; } ||
   ! "$herdr" pane list >/dev/null 2>&1; then
  if [[ -n $dry ]]; then echo "not in herdr: would run: bash -c $(printf '%q' "${cmd:-${SHELL:-bash}}")${opt_cwd:+ (in $opt_cwd)}"; exit 0; fi
  [[ -z $opt_cwd ]] || cd "$opt_cwd"
  [[ -n $cmd ]] || exec "${SHELL:-bash}" # no command: a shell in the directory
  exec bash -c "$cmd"
fi

# is_idle INFO: the pane's shell is its foreground process group. A fast-path pane (see the herdr-task-runner plugin)
# has no shell: the command is exec'd, so it is its own "shell_pid" and would look idle without the name check.
is_idle() {
  local fg sh_pid name
  fg="$(jnum foreground_process_group_id "$1")"; sh_pid="$(jnum shell_pid "$1")"
  name="$(jstr name "$1")"
  [[ -n $fg && $fg == "$sh_pid" ]] || return 1
  case ${name#-} in bash|zsh|sh|dash|fish|ksh|nu|elvish|xonsh|tcsh|csh) return 0 ;; *) return 1 ;; esac
}

# <cmd> as a shell snippet, optionally followed by a linger.
# It is typed into the pane's own shell (not `bash -c`) and starts with <cmd> itself, so shell
# integrations that label a pane by the first word of the line (herdr-ohmyzsh) show the real command.
q() { printf '%q' "$1"; }
snippet="$cmd"
idle_run="$snippet" # an idle pane's shell: no linger (the shell stays open), see run_idle
if [[ -n $keep || -n $linger ]]; then
  # herdr drops the sidebar entry as soon as the shell is the foreground process again; herdr-run-hold marks
  # it done and keeps it (as a process of the same name) until the pane is focused. With --linger it also
  # runs the countdown (started now, whether or not you look at the pane): it exits non-zero when you
  # press the keep key, then the line ends without `exit` and the tab stays open.
  snippet+="; rc=\$?"
  # typed into the terminal, so keep it short: `herdr-run-hold` when the shell finds it on PATH (the pane's
  # shell has the same PATH as this one, see ../shell.sh), else its path written with ~ when under $HOME.
  # The command itself is not repeated (herdr-run-hold reads it back from a pane token).
  here="$(cd "$(dirname "$0")" && pwd)"
  if [[ "$(readlink -f "$(command -v herdr-run-hold 2>/dev/null)" 2>/dev/null)" == "$(readlink -f "$here/herdr-run-hold")" ]]; then
    hold=herdr-run-hold
  elif [[ $here == "$HOME"/* ]]; then hold="~/$(q "${here#"$HOME"/}/herdr-run-hold")"
  else hold="$(q "$here/herdr-run-hold")"; fi
  hold_args="$(q "$(label_of "$cmd")") \$rc"
  # in an idle pane the shell must stay open, so there is no countdown, but the "done"/"failed" mark is
  # kept the same way (until you focus the pane)
  idle_run="$snippet; $hold $hold_args"
  if [[ -n $linger ]]; then
    snippet+="; if $hold --linger $(q "$linger") $hold_args; then exit \$rc; fi"
  else
    snippet+="; $hold $hold_args"
  fi
fi

# focus_events PANE: with --keep/--linger, herdr-run-hold has to know whether you were away from the terminal
# when the command ended (see the header of herdr-run-hold for why herdr's own focus flag can't tell). The
# terminal reports that as escape codes once DEC mode 1004 is on: ESC[O when you leave, ESC[I when you come
# back; herdr forwards them to the pane. They have to be switched on BEFORE the command starts, because the
# switch-away usually happens while it runs; they then wait in the tty input until herdr-run-hold reads them.
#  - printf ...1004h  switches the reports on (herdr-run-hold switches them off again)
#  - stty -echo       stops the tty echoing those codes into the command's output as ^[[O / ^[[I
# It is a separate typed line, not a prefix of the command line, because herdr-ohmyzsh labels the sidebar
# entry with the first word of the line, which must be the command itself (so no `printf ...; cmd`).
focus_events() {
  [[ -n $keep || -n $linger ]] || return 0
  hc pane run "$1" "printf '\\033[?1004h'; stty -echo" >/dev/null
}

# run_idle PANE: type the command into the idle pane's own shell. With --keep/--linger it is set up like a
# new tab (focus events, sidebar name), so that herdr-run-hold keeps the "done"/"failed" mark in the sidebar
# once the command finishes, instead of it vanishing as soon as the shell is the foreground process again.
run_idle() {
  [[ -n $cmd ]] || return 0
  focus_events "$1"
  hc pane run "$1" "$idle_run" >/dev/null
  [[ -z $keep && -z $linger ]] || name_pane "$1"
}

# typed into a new pane's shell: close it when done unless --keep/--linger. (Without them
# the command takes the fast path below and never gets here, so rc is always set when needed.)
if [[ -n $keep || -n $linger ]]; then run="$snippet"; else run="$snippet; exit \$rc"; fi

# The focused pane: everything after its "focused":true marker up to its last key ("workspace_id").
list="$("$herdr" pane list)"
after="${list##*\"focused\":true}"
[[ $after != "$list" ]] || { [[ -n $dry ]] && echo "no focused pane: would run: bash -c $(printf '%q' "$cmd")" && exit 0; exec bash -c "$cmd"; }
focused="${after%%\"workspace_id\"*}"
pane="$(jstr pane_id "$focused")"
pane_cwd="$(jstr foreground_cwd "$focused")"
[[ -n $pane_cwd ]] || pane_cwd="$(jstr cwd "$focused")"
[[ -n $pane ]] || fail "could not find the focused pane in: ${list:0:120}"
cwd="${opt_cwd:-$pane_cwd}"
# bg_done: with --background, say right away that the command was sent (nothing else shows it), then exit
bg_done() {
  [[ -z $bg ]] || { local n="Started in background: ${cmd:0:70}"
    if [[ -n $dry ]]; then echo "would notify: $n"; else "$herdr" notification show "$n" >/dev/null 2>&1 || true; fi; }
  exit 0
}

# what a new tab/workspace gets so that it takes (or, with --background, doesn't take) you there
tab_focus=--focus ws_focus=--focus
[[ -z $bg ]] || { tab_focus= ws_focus=--no-focus; }

# --work-dir: already there means the default behaviour, elsewhere it is --workspace's
if [[ $mode == workdir ]]; then
  if [[ "$(cd "$cwd" && pwd -P)" == "$(cd "$pane_cwd" 2>/dev/null && pwd -P)" ]]; then mode=auto; opt_cwd=; else mode=workspace; fi
fi
[[ -z $dry ]] || echo "mode=$mode pane=$pane cwd=$cwd"
[[ -n $cmd || $mode != auto ]] || exit 0 # no command and already in the directory

# --reuse: a command already running in this workspace is jumped to, not started a second time. Matched on
# the whole command line of a pane's foreground process (`nvim .` and `nvim file` are different). Both sides
# are compared without quotes, extra blanks and the program's directory, because the shell has already
# removed them from what actually runs.
norm_cmd() {
  sed -e "s/[\\\\'\"]//g" -e 's/[[:space:]][[:space:]]*/ /g' -e 's/^ //; s/ $//' -e 's#^[^ ]*/##' <<<"$1"
}
if [[ -n $reuse && ( $mode == auto || $mode == tab ) ]]; then
  want="$(norm_cmd "$cmd")"
  ws="$(jstr workspace_id "$after")"
  while IFS= read -r rec; do
    [[ "$(jstr workspace_id "$rec")" == "$ws" ]] || continue
    info="$("$herdr" pane process-info --pane "$(jstr pane_id "$rec")")"
    running="$(grep -o '"cmdline":"\([^"\\]\|\\.\)*"' <<<"$info" | head -n1 | cut -d'"' -f4- || true)"
    [[ -n $running && "$(norm_cmd "${running%\"}")" == "$want" ]] || continue
    hc tab focus "$(jstr tab_id "$rec")" >/dev/null
    [[ -z $dry ]] || echo "already running in tab $(jstr tab_id "$rec"): jumping to it"
    exit 0
  done < <(sed 's/"workspace_id":"[^"]*"}/&\n/g' <<<"$list")
fi

# Fast path: nothing to wrap (no linger/keep), so start the command directly in a plugin
# pane instead of typing it into a freshly started shell, which has to finish starting up first.
fast=
[[ -z $linger && -z $keep ]] && fast=1

if [[ $mode == split && -n $fast ]]; then
  out="$(hc plugin pane open --plugin herdr-task-runner --entrypoint run --placement split \
    --target-pane "$pane" --direction right --cwd "$cwd" --env "HERDR_TASK_RUNNER_CMD=$cmd" --focus)" || exit 1
  check "$out"
  exit 0
fi

if [[ $mode == split ]]; then
  out="$(hc pane split --pane "$pane" --direction right --cwd "$cwd" --focus)" || exit 1; check "$out"
  new="$(jstr pane_id "$out")"
  [[ -n $new || -n $dry ]] || fail "no pane id in herdr reply: ${out:0:120}"
  focus_events "${new:-<new-pane>}"
  hc pane run "${new:-<new-pane>}" "$run" >/dev/null
  name_pane "${new:-<new-pane>}"
  exit 0
fi

if [[ $mode == workspace ]]; then
  # Only an exact match counts. The focused pane when it is in $cwd already (idle: the command is typed into
  # it), else a workspace with a pane in $cwd, else a new workspace. A pane in another directory, below or
  # above $cwd as well, is never cd'ed or reused.
  info="$("$herdr" pane process-info --pane "$pane")"
  if [[ $cwd == "$pane_cwd" && -z $bg ]] && is_idle "$info"; then
    [[ -z $dry ]] || echo "idle pane: typing into it"
    run_idle "$pane"
    exit 0
  fi
  # A workspace already open in $cwd is reused instead of opening a duplicate: an idle pane of it runs the
  # command (preferred), else a new tab in it.
  phys="$(cd "$cwd" && pwd -P)"
  idle_pane= idle_tab= idle_ws= exact_ws=
  while IFS= read -r rec; do
    exact=
    for c in "$(jstr foreground_cwd "$rec")" "$(jstr cwd "$rec")"; do
      if [[ -n $c && ( $c == "$cwd" || $c == "$phys" ) ]]; then exact=1; break; fi
    done
    [[ -n $exact ]] || continue
    w="$(jstr workspace_id "$rec")"
    exact_ws="${exact_ws:-$w}"
    [[ -z $bg || $w != "$(jstr workspace_id "$after")" ]] || continue # background: not in the workspace you are in
    info="$("$herdr" pane process-info --pane "$(jstr pane_id "$rec")")"
    if is_idle "$info"; then
      idle_pane="$(jstr pane_id "$rec")"; idle_tab="$(jstr tab_id "$rec")"; idle_ws=$w
      break
    fi
  done < <(sed 's/"workspace_id":"[^"]*"}/&\n/g' <<<"$list")
  ws_id=$exact_ws
  if [[ -n $idle_pane ]]; then
    [[ -z $dry ]] || echo "idle pane $idle_pane of the workspace already open in $cwd: typing into it"
    if [[ -z $bg ]]; then
      hc workspace focus "$idle_ws" >/dev/null
      hc tab focus "$idle_tab" >/dev/null
    fi
    run_idle "$idle_pane"
    bg_done
  fi
  if [[ -z $cmd && -n $ws_id ]]; then # nothing to run: just go to the workspace that is there
    [[ -n $bg ]] || hc workspace focus "$ws_id" >/dev/null
    bg_done
  fi
  if [[ -n $ws_id ]]; then
    [[ -z $dry ]] || echo "workspace $ws_id is open in $cwd but busy: new tab in it"
    out="$(hc tab create --workspace "$ws_id" --cwd "$cwd" $tab_focus)" || exit 1; check "$out"
    [[ -n $bg ]] || hc workspace focus "$ws_id" >/dev/null
  else
    out="$(hc workspace create --cwd "$cwd" --label "$(basename "$cwd")" $ws_focus)" || exit 1; check "$out"
  fi
  root="$(jstr pane_id "$out")"
  [[ -n $root || -n $dry ]] || fail "no pane id in herdr reply: ${out:0:120}"
  [[ -n $cmd ]] || bg_done
  focus_events "${root:-<new-pane>}"
  hc pane run "${root:-<new-pane>}" "$run" >/dev/null
  name_pane "${root:-<new-pane>}"
  bg_done
fi

if [[ $mode == auto && -z $bg && ( -z $opt_cwd || $opt_cwd == "$pane_cwd" ) ]]; then
  info="$("$herdr" pane process-info --pane "$pane")"
  if is_idle "$info"; then # the shell itself is the foreground process group
    [[ -z $dry ]] || echo "idle pane: typing into it"
    run_idle "$pane"
    exit 0
  fi
fi

if [[ -n $fast ]]; then
  out="$(hc plugin pane open --plugin herdr-task-runner --entrypoint run --placement tab \
    --cwd "$cwd" --env "HERDR_TASK_RUNNER_CMD=$cmd" $tab_focus)" || exit 1
  check "$out"
  tab="$(jstr tab_id "$out")"
  [[ -n $tab || -n $dry ]] || fail "no tab id in herdr reply: ${out:0:120}"
  # --focus alone doesn't switch tabs. A very short command may already have closed its tab: not an error.
  if [[ -n $bg ]]; then :
  elif [[ -n $dry ]]; then hc tab focus "<new-tab>"; else "$herdr" tab focus "$tab" >/dev/null 2>&1 || true; fi
  bg_done
fi

out="$(hc tab create --cwd "$cwd" $tab_focus)" || exit 1; check "$out"
root="$(jstr pane_id "$out")"
[[ -n $root || -n $dry ]] || fail "no pane id in herdr reply: ${out:0:120}"
focus_events "${root:-<new-pane>}"
hc pane run "${root:-<new-pane>}" "$run" >/dev/null
name_pane "${root:-<new-pane>}"
bg_done
