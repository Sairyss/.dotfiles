#!/usr/bin/env bash
# Usage: herdr-run-hold [--typed START_EPOCH] [--linger DURATION] LABEL EXIT_CODE [COMMAND...]
# (--typed: called by hooks.zsh from the prompt for a command you typed; START_EPOCH is when it started. It reads no
# keys from the terminal and only waits while you are away from the pane.)
# (COMMAND and the start time default to the `cmd` and `start` pane tokens herdr-run set when the command
# started. They are not arguments so the line typed into the shell is the same every time and shell history
# (atuin) doesn't fill up with one-off lines.)
# Called by herdr-run when a --keep/--linger command has finished. Two jobs:
#
# 1. Sidebar entry, for a pane you are not looking at. A command that succeeded and ran at least
#    [jobs] run_threshold seconds (default 10) is marked done. A command that failed
#    (non-zero exit, however long it ran) is marked blocked, herdr's "needs attention" state, labelled
#    "failed (exit N)", with a `result` token "✗ exit N" for sidebar rules. Either stays until the pane
#    is focused, like herdr does for agents; with --linger the wait also ends when the linger is over.
#    herdr drops a reported entry as soon as the pane's foreground process is the plain shell again
#    (that is why it used to vanish when the command finished). It keeps it while a process named like
#    the entry is in the foreground, so this waits as a process with that name.
#
#    Whether you are away is read from the terminal's focus events (herdr-run turns them on when it types the
#    command): herdr's own focus flag stays true when herdr runs inside another terminal (an ssh/incus
#    session) and you switch away from that terminal, and herdr's API never reports "done" (its sidebar works
#    that out per client from the same events).
#
# The keep key (default `k`, HERDR_TASK_RUNNER_KEEP_KEY) works at any time: a `k` typed while the command runs (it waits
# in the terminal's input buffer until now), or while this waits for you to come back, cancels the linger and
# keeps the tab open, same as in the countdown.
#
# 2. With --linger: the countdown to DURATION after the command finished, whether or not the pane was
#    focused. Ctrl-C closes now, the keep key keeps the pane open. Exit status: 0 = close the pane, 1 = keep it (you pressed the keep key, or the
#    command failed: a failure has no countdown and its mark waits until you focus the pane).
#    Without --linger the exit status is always 0.
set -uo pipefail

typed=
if [[ ${1:-} == --typed ]]; then typed="${2:?start epoch}"; shift 2; fi # called by hooks.zsh for a command you typed
linger=
if [[ ${1:-} == --linger ]]; then linger="${2:?duration}"; shift 2; fi
label="${1:?label}" rc="${2:?exit code}"; shift 2
cmd="$*"
herdr="${HERDR_BIN_PATH:-herdr}"
# settings of the plugin's [jobs] table, written by sidebar.py (see hooks.zsh); the environment overrides them
_tr_source=task-runner _tr_run_threshold=10 _tr_terminal_threshold=10
env_file="${HERDR_PLUGIN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/herdr-task-runner}/shell.env"
# shellcheck disable=SC1090
[[ ! -r $env_file ]] || . "$env_file"
threshold="${HERDR_TASK_RUNNER_RUN_THRESHOLD:-$_tr_run_threshold}"
[[ -z $typed ]] || threshold="${HERDR_TASK_RUNNER_THRESHOLD:-$_tr_terminal_threshold}"
source_id="$_tr_source"
pane="${HERDR_PANE_ID:-}"
start= info=
[[ -z $pane ]] || info="$("$herdr" pane get "$pane" 2>/dev/null)"
[[ -n $cmd ]] || cmd="$(grep -o '"cmd":"[^"]*"' <<<"$info" | head -n1 | cut -d'"' -f4)" # the tokens herdr-run set
start="$(grep -o '"start":"[0-9]*"' <<<"$info" | head -n1 | cut -d'"' -f4)"
[[ -n $cmd ]] || cmd="$label"
[[ -z $typed ]] || start=$typed
[[ -n $start ]] || start="$(date +%s)"

# the moment the linger is over, counted from now (the command just finished)
deadline=0
if [[ -n $linger ]]; then
  n="${linger%[smhd]}"
  case ${linger: -1} in
    m) secs=$((n * 60)) ;;
    h) secs=$((n * 3600)) ;;
    d) secs=$((n * 86400)) ;;
    *) secs=$n ;;
  esac
  deadline=$(($(date +%s) + secs))
fi
# a failed command keeps its tab open (Ctrl-C, exit 130, is a decision of yours, not a failure): no countdown, the
# mark waits until you focus the pane
failed_keep=0
if [[ -n $linger ]] && ((rc != 0 && rc != 130)); then failed_keep=1 deadline=0; fi

# herdr-run gave this entry the full command as display name when the command started (herdr shows only
# the short label, "npm"); clear it on every way out so a later job with the same label doesn't inherit it
meta() { "$herdr" pane report-metadata "$pane" --source "$source_id" --agent "$label" \
  "$@" --seq "$(date +%s%6N)" >/dev/null 2>&1; }
# everything herdr-run/this script put on the entry besides the state itself
clear_meta() { meta --clear-display-agent --clear-state-labels --clear-token result --clear-token cmd --clear-token start; }
focused() { [[ "$("$herdr" pane get "$pane" 2>/dev/null)" == *'"focused":true'* ]]; }
dir=
# focus events off again on every way out (Ctrl-C included): left on, herdr keeps typing ESC[I / ESC[O into the
# shell, which e.g. flips a vi-mode zsh to command mode so the next line herdr-run types arrives garbled
focus_off() { if have_tty; then printf '\033[?1004l' >/dev/tty; stty echo </dev/tty 2>/dev/null; fi; }
trap '[[ -z $dir ]] || rm -rf "$dir"; focus_off; [[ -z $pane ]] || clear_meta' EXIT
trap 'exit 0' INT # Ctrl-C while waiting: close now (exit status 0), like in the countdown

release() { "$herdr" pane release-agent "$pane" --source "$source_id" --agent "$label" --seq "$(date +%s%6N)" >/dev/null 2>&1; }

# focus events from the terminal, if herdr-run turned them on (ESC [ I = focus in, ESC [ O = focus out)
outer_out=0 kept=0
keep_key="${HERDR_TASK_RUNNER_KEEP_KEY:-k}"
# a typed command is held from the shell prompt: the keys you type there are not for this script to read
have_tty() { [[ -z $typed ]] && { : </dev/tty; } 2>/dev/null; }
drain_events() {
  local c r
  while IFS= read -rsn1 -t 0.05 c </dev/tty 2>/dev/null; do
    [[ $c == "$keep_key" ]] && kept=1
    [[ $c == $'\e' ]] || continue
    IFS= read -rsn2 -t 0.05 r </dev/tty 2>/dev/null
    case $r in '[O') outer_out=1 ;; '[I') outer_out=0 ;; esac
  done
}

# countdown DEADLINE: wait until the epoch second DEADLINE. Exit status 0 = close the pane, 1 = keep it
# (the keep key); Ctrl-C closes now. Without a terminal to read keys from it is just a sleep.
countdown() {
  local end=$1 left key
  ((end > $(date +%s))) || return 0 # already over
  if ! have_tty; then sleep $((end - $(date +%s))); return 0; fi
  trap 'printf "\r\033[2K"; exit 0' INT
  drain_events # keys typed while the hold waited: only the keep key counts
  if ((kept)); then printf '\r\033[2K[herdr-run] kept open\n'; return 1; fi
  while ((left = end - $(date +%s), left > 0)); do
    printf '\r\033[2K[herdr-run] closing in %ss  ·  %s: keep this tab open  ·  Ctrl-C: close now' "$left" "$keep_key"
    if read -rsn1 -t 1 key </dev/tty && [[ $key == "$keep_key" ]]; then
      printf '\r\033[2K[herdr-run] kept open\n'
      return 1
    fi
  done
  printf '\r\033[2K'
}

hold() {
  [[ -n $pane ]] || return 0
  local took=$(($(date +%s) - start)) state=idle
  if ((rc != 0)); then
    state=blocked # a failure is shown whatever its duration
  elif ((took < $threshold)); then
    release; return 0 # too quick to be worth showing
  fi
  # hooks.zsh marked the entry working and only clears that when the prompt comes back, which is after
  # this script (the linger countdown), so an entry we don't hold has to be dropped here.
  local away=0 by=outer
  ((outer_out)) && away=1
  focused || { away=1; by=flag; } # you switched to another tab/workspace of this herdr
  if ((!away)); then release; return 0; fi # you are looking at it

  "$herdr" pane report-agent "$pane" --source "$source_id" --agent "$label" --state "$state" \
    --message "$cmd (exit $rc, took ${took}s)" --seq "$(date +%s%6N)" >/dev/null 2>&1 || return 0
  # the full command is the entry's name (herdr's own toast and sidebar show it instead of just "npm"); a
  # metadata call replaces the name set by herdr-run unless it repeats it
  name="$cmd"; ((${#name} > 80)) && name="${name:0:79}…"
  if [[ $state == blocked ]]; then
    meta --display-agent "$name" --state-label "blocked=failed (exit $rc)" --token "result=✗ exit $rc"
  else
    meta --display-agent "$name"
  fi

  # the waiting process is a copy of bash under the entry's name
  dir="$(mktemp -d)" || return 0
  ln -s "$(command -v bash)" "$dir/$label"
  # ends when you are back (a focus-in event, or the pane is focused when you were away inside herdr) or the
  # linger is over
  cat >"$dir/wait.sh" <<'WAIT'
herdr="$1" pane="$2" deadline="$3" by="$4" key="$5" typed="${6:-}"
tty=0
if [[ -z $typed ]] && { : </dev/tty; } 2>/dev/null; then tty=1; fi
while :; do
  if ((tty)); then
    if IFS= read -rsn1 -t 1 c </dev/tty; then
      [[ $c == "$key" ]] && exit 3 # keep this tab open
      if [[ $c == $'\e' ]]; then
        IFS= read -rsn2 -t 0.05 r </dev/tty
        [[ $by == outer && $r == '[I' ]] && break
      fi
    fi
  else
    sleep 1
  fi
  [[ $by == flag && "$("$herdr" pane get "$pane" 2>/dev/null)" == *'"focused":true'* ]] && break
  ((deadline > 0)) && (($(date +%s) >= deadline)) && break
done
WAIT
  "$dir/$label" "$dir/wait.sh" "$herdr" "$pane" "$deadline" "$by" "$keep_key" "$typed"
  (($? == 3)) && kept=1 # the keep key
  release
}

have_tty && drain_events # focus events and keys typed while the command ran
hold
focus_off
[[ -z $pane ]] || clear_meta # the entry is gone now; don't leave the name or labels behind

if [[ -n $linger ]]; then
  if ((failed_keep)); then printf '\r\033[2K[herdr-run] failed (exit %s), kept open\n' "$rc"; exit 1; fi
  if ((kept)); then printf '\r\033[2K[herdr-run] kept open\n'; exit 1; fi
  countdown "$deadline"
  exit $?
fi
exit 0
