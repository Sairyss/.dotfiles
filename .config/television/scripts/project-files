#!/usr/bin/env bash
# Usage: project-files list [global|project] | preview <file> | open <file>
# `list global` (default): files of the top zoxide directories that are git projects, whichever directory you
# are in. `list project`: the narrow scope, files of the current git project (current directory or its root),
# else the same as global (see lib/scope-dirs.sh). Prints: absolute path, display label ("[project] path"
# when several projects can show up, else the path relative to the project). `open` hands the file to
# herdr-run --edit: the nvim of the project's workspace gets it and you are taken there, else a new tab runs nvim.
# Needs fd (list), bat (preview, falls back to head), herdr-run (open).
set -euo pipefail
source "${TELEVISION_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/television}/scripts/lib/scope-dirs.sh"
source "${TELEVISION_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/television}/scripts/lib/herdr-run.sh"

is_project() { git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1 && [[ $(git -C "$1" rev-parse --show-toplevel) == "$1" ]]; }

# the top zoxide directories that are git projects, best first
global_dirs() {
  local dir
  command -v zoxide >/dev/null 2>&1 || return 0
  { zoxide query --list 2>/dev/null || true; } | while IFS= read -r dir; do
    [[ -d $dir ]] && is_project "$dir" && printf '%s\n' "$dir"
  done | head -n "${1:-10}" || true
}

list() {
  local scope=${1:-global} top dir label
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  while IFS= read -r dir; do
    label=
    if [[ $scope == global ]]; then label="[$(basename "$dir")] "
    else [[ $dir == "$PWD" || $dir == "$top" ]] || label="[$(basename "$dir")] "; fi
    # fd skips what .gitignore does; hidden files are kept, .git is not
    fd --type f --hidden --exclude .git --base-directory "$dir" --color never |
      while IFS= read -r f; do printf '%s\t%s%s\n' "$dir/$f" "$label" "$f"; done
  done < <(if [[ $scope == global ]]; then global_dirs 10; else scope_dirs is_project 10; fi)
}

case ${1:-} in
  list)    case ${2:-global} in global|project) list "${2:-global}" ;; *) echo "project-files: unknown scope: $2" >&2; exit 2 ;; esac ;;
  preview) if command -v bat >/dev/null 2>&1; then bat --color=always --style=numbers --line-range=:200 -- "$2"; else head -n 200 -- "$2"; fi ;;
  open)    exec "$(herdr_run_bin)" --edit "$2" ;;
  *) echo "usage: project-files list [global|project] | preview <file> | open <file>" >&2; exit 2 ;;
esac
